/*========================================================
                    QUESTION 10
  Find the course in which maximum number of
  students have taken admission in current month
========================================================*/

SELECT C.COURSE_NO,
       C.COURSE_NAME,
       COUNT(CT.PROSPECTUS_NO) AS TOTAL_STUDENTS
FROM COURSE C
JOIN COURSE_TAKEN CT
ON C.COURSE_NO = CT.COURSE_NO
WHERE TO_CHAR(CT.START_DT,'MM-YYYY')
      =
      TO_CHAR(SYSDATE,'MM-YYYY')
GROUP BY C.COURSE_NO,
         C.COURSE_NAME
HAVING COUNT(CT.PROSPECTUS_NO)
       =
       (
           SELECT MAX(CNT)
           FROM
           (
               SELECT COUNT(*) AS CNT
               FROM COURSE_TAKEN
               WHERE TO_CHAR(START_DT,'MM-YYYY')
                     =
                     TO_CHAR(SYSDATE,'MM-YYYY')
               GROUP BY COURSE_NO
           )
       );


/* OUTPUT

COURSE_NO  COURSE_NAME    TOTAL_STUDENTS
---------  -------------  --------------
C101       C Programming  2
*/
